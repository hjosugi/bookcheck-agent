{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "bookcheck-agent",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "bookcheck-agent"
  },
  "runtimes": [
    {
      "name": "BookChecker",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": "app/BookChecker/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "BookCheckerMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaces": ["/users/{actorId}/facts"]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaces": ["/users/{actorId}/preferences"]
        },
        {
          "type": "SUMMARIZATION",
          "namespaces": ["/summaries/{actorId}/{sessionId}"]
        }
      ]
    }
  ],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "harnesses": [],
  "configBundles": [],
  "abTests": [],
  "httpGateways": []
}

{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "BookcheckAgent",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "BookcheckAgent"
  },
  "runtimes": [
    {
      "name": "BookChecker",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": "app/BookChecker/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [{ "name": "CREDENTIAL_PROVIDER_NAME", "value": "google-oauth-client" }],
      "additionalPolicies": [
        "arn:aws:iam::aws:policy/AmazonBedrockFullAccess",
        "arn:aws:iam::aws:policy/BedrockAgentCoreFullAccess"
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_kTV2qzSpg/.well-known/openid-configuration",
          "allowedClients": ["5r6vps8b5fhc02urmn3gk8rrem"]
        }
      }
    }
  ],
  "memories": [
    {
      "name": "BookCheckerMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaces": ["/users/{actorId}/facts"]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaces": ["/users/{actorId}/preferences"]
        },
        {
          "type": "SUMMARIZATION",
          "namespaces": ["/summaries/{actorId}/{sessionId}"]
        }
      ]
    }
  ],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "harnesses": [],
  "configBundles": [],
  "abTests": [],
  "httpGateways": []
}

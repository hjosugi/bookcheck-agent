{
  "name": "agentcore-cdk-app",
  "version": "0.1.0",
  "bin": {
    "cdk": "dist/bin/cdk.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "cdk": "npm run build && cdk",
    "clean": "rm -rf dist",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "check": "npm run format:check && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@aws/agentcore-cdk": "0.1.0-alpha.45",
    "aws-cdk-lib": "~2.261.0",
    "constructs": "~10.7.0"
  },
  "devDependencies": {
    "@types/jest": "~29.5.14",
    "@types/node": "~24.13.3",
    "aws-cdk": "~2.1126.0",
    "jest": "~29.7.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "prettier": "~3.9.5",
    "ts-jest": "~29.4.11",
    "typescript": "~5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@vitest/mocker@>=4.0.0 <4.1.12": "4.1.12",
    "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
    "handlebars@>=4.0.0 <4.7.10": "4.7.10",
    "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
    "tinypool@>=2.0.0 <2.1.2": "2.2.0",
    "vite@>=8.0.0 <8.3.3": "8.3.5",
    "zod@>=4.0.0 <4.6.6": "4.6.7"
  }
}

AWS_DEFAULT_REGION=us-east-1

# Amazon Nova Pro via the US cross-region inference profile.
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# Set these when testing Google Calendar through AgentCore Identity.
# CREDENTIAL_PROVIDER_NAME=google-oauth-client-XXXXX
# CALLBACK_URL=http://localhost:3000/api/oauth2/callback

# Hard cap on agent loop turns (default 15). Stops the model from
# retrying a failing browser selector forever.
# AGENT_MAX_TURNS=15

# AgentCore injects this when the managed memory is deployed.
# Leave it unset for local chat without AgentCore Memory.
# MEMORY_BOOKCHECKERMEMORY_ID=
